{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultima IV",
  "version": "0.1.0",
  "identifier": "dev.u4.ts",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Ultima IV - Quest of the Avatar", "width": 1280, "height": 840, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
